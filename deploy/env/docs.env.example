# Copy to /etc/google-mcp/docs.env.
# Set both OAuth login values before starting the service.
DOCS_MCP_PUBLIC_URL=https://mcp.hawkxdev.dev/docs
DOCS_MCP_HOST=127.0.0.1
DOCS_MCP_PORT=8435
DOCS_MCP_PATH=/docs/mcp
DOCS_MCP_ALLOWED_HOSTS=mcp.hawkxdev.dev
DOCS_MCP_FORWARDED_ALLOW_IPS=127.0.0.1
DOCS_OAUTH_STATE_PATH=/var/lib/google-workspace-mcp/docs/oauth_state.sqlite3
DOCS_GOOGLE_TOKEN_PATH=/var/lib/google-workspace-mcp/docs/google_token.json
DOCS_AUDIT_LOG_PATH=/var/log/google-workspace-mcp/docs/audit.jsonl
DOCS_MCP_DOWNLOAD_PATH=/var/lib/google-workspace-mcp/docs/downloads
DOCS_OAUTH_LOGIN_USERNAME=
DOCS_OAUTH_LOGIN_PASSWORD=
