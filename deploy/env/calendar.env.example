# Copy to /etc/google-mcp/calendar.env.
# Set both OAuth login values before starting the service.
CALENDAR_MCP_PUBLIC_URL=https://mcp.hawkxdev.dev/calendar
CALENDAR_MCP_HOST=127.0.0.1
CALENDAR_MCP_PORT=8432
CALENDAR_MCP_PATH=/calendar/mcp
CALENDAR_MCP_ALLOWED_HOSTS=mcp.hawkxdev.dev
CALENDAR_MCP_FORWARDED_ALLOW_IPS=127.0.0.1
CALENDAR_OAUTH_STATE_PATH=/var/lib/google-workspace-mcp/calendar/oauth_state.sqlite3
CALENDAR_GOOGLE_TOKEN_PATH=/var/lib/google-workspace-mcp/calendar/google_token.json
CALENDAR_AUDIT_LOG_PATH=/var/log/google-workspace-mcp/calendar/audit.jsonl
CALENDAR_MCP_DOWNLOAD_PATH=/var/lib/google-workspace-mcp/calendar/downloads
CALENDAR_OAUTH_LOGIN_USERNAME=
CALENDAR_OAUTH_LOGIN_PASSWORD=
