# Copy to /etc/google-mcp/drive.env.
# Set both OAuth login values before starting the service.
DRIVE_MCP_PUBLIC_URL=https://mcp.hawkxdev.dev/drive
DRIVE_MCP_HOST=127.0.0.1
DRIVE_MCP_PORT=8433
DRIVE_MCP_PATH=/drive/mcp
DRIVE_MCP_ALLOWED_HOSTS=mcp.hawkxdev.dev
DRIVE_MCP_FORWARDED_ALLOW_IPS=127.0.0.1
DRIVE_OAUTH_STATE_PATH=/var/lib/google-workspace-mcp/drive/oauth_state.sqlite3
DRIVE_GOOGLE_TOKEN_PATH=/var/lib/google-workspace-mcp/drive/google_token.json
DRIVE_AUDIT_LOG_PATH=/var/log/google-workspace-mcp/drive/audit.jsonl
DRIVE_MCP_DOWNLOAD_PATH=/var/lib/google-workspace-mcp/drive/downloads
DRIVE_OAUTH_LOGIN_USERNAME=
DRIVE_OAUTH_LOGIN_PASSWORD=
