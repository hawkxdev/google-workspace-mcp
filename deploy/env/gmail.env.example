# Copy to /etc/google-mcp/gmail.env.
# Set both OAuth login values before starting the service.
GMAIL_MCP_PUBLIC_URL=https://mcp.hawkxdev.dev/gmail
GMAIL_MCP_HOST=127.0.0.1
GMAIL_MCP_PORT=8431
GMAIL_MCP_PATH=/gmail/mcp
GMAIL_MCP_ALLOWED_HOSTS=mcp.hawkxdev.dev
GMAIL_MCP_FORWARDED_ALLOW_IPS=127.0.0.1
GMAIL_OAUTH_STATE_PATH=/var/lib/google-workspace-mcp/gmail/oauth_state.sqlite3
GMAIL_GOOGLE_TOKEN_PATH=/var/lib/google-workspace-mcp/gmail/google_token.json
GMAIL_AUDIT_LOG_PATH=/var/log/google-workspace-mcp/gmail/audit.jsonl
GMAIL_MCP_DOWNLOAD_PATH=/var/lib/google-workspace-mcp/gmail/downloads
GMAIL_OAUTH_LOGIN_USERNAME=
GMAIL_OAUTH_LOGIN_PASSWORD=
