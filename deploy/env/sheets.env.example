# Copy to /etc/google-mcp/sheets.env.
# Set both OAuth login values before starting the service.
SHEETS_MCP_PUBLIC_URL=https://mcp.hawkxdev.dev/sheets
SHEETS_MCP_HOST=127.0.0.1
SHEETS_MCP_PORT=8434
SHEETS_MCP_PATH=/sheets/mcp
SHEETS_MCP_ALLOWED_HOSTS=mcp.hawkxdev.dev
SHEETS_MCP_FORWARDED_ALLOW_IPS=127.0.0.1
SHEETS_OAUTH_STATE_PATH=/var/lib/google-workspace-mcp/sheets/oauth_state.sqlite3
SHEETS_GOOGLE_TOKEN_PATH=/var/lib/google-workspace-mcp/sheets/google_token.json
SHEETS_AUDIT_LOG_PATH=/var/log/google-workspace-mcp/sheets/audit.jsonl
SHEETS_MCP_DOWNLOAD_PATH=/var/lib/google-workspace-mcp/sheets/downloads
SHEETS_OAUTH_LOGIN_USERNAME=
SHEETS_OAUTH_LOGIN_PASSWORD=
